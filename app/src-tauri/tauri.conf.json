{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Factory Archive",
  "version": "0.1.0",
  "identifier": "com.factoryarchive.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Factory Archive \u2014 Blueprint Manager",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "backgroundColor": "#0c0e11",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "category": "Utility"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyQjVEODEyNjVBMzA5RDEKUldUUkNhTmxFdGkxOHNkbFQrOGdmOG9vQ2lxYWdUODJHU3dZci9YRU5oQ3A5ajlQMTZ2TVJDMEUK",
      "endpoints": [
        "https://github.com/mike623/factory-archive/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}